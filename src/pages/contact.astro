
---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contacto">
  <main class="contact-page">
    <section class="contact-intro">
      <p class="contact-eyebrow">Holi</p>
      <h1>Contacto</h1>
      <p class="contact-lead">
        ¿Tienes una idea, un proyecto o una propuesta de colaboración?
      </p>
      <p class="contact-description">
        Trabajo en la intersección entre música, tecnología y arte audiovisual.
        Estoy abierta a colaboraciones artísticas, encargos musicales y proyectos
        que exploren nuevas formas de escuchar y experimentar el sonido.
      </p>
    </section>

    <section class="contact-options" aria-label="Formas de contacto">
      <a class="contact-card" href="mailto:e.garciaverduras@gmail.com">
        <span class="contact-label">CORREO ELECTRÓNICO</span>
        <span class="contact-value">e.garciaverduras@gmail.com</span>
        <span class="contact-action">Escríbeme ↗</span>
      </a>

      <a
        class="contact-card"
        href="https://instagram.com/elenagarciaverduras"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="contact-label">INSTAGRAM</span>
        <span class="contact-value">@elenagarciaverduras</span>
        <span class="contact-action">Sígueme ↗</span>
      </a>
    </section>

    <p class="contact-note">
      También puedes escribirme simplemente para saludar.
    </p>
  </main>
</Layout>
